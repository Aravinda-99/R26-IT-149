FLASK_PORT=5000
FLASK_DEBUG=True
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json

# Component 4: LLM Question Generation
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-flash-latest
USE_LLM_QUESTION_GENERATION=true
ALLOW_MOCK_QUESTIONS=false

# Authentication Seed Accounts (Passwords must be hashed, never commit real passwords)
SEED_STUDENT_EMAIL=student001@codequest.lk
SEED_STUDENT_PASSWORD=Student@12345

SEED_TEACHER_EMAIL=teacher001@codequest.lk
SEED_TEACHER_PASSWORD=Teacher@12345

SEED_ADMIN_EMAIL=admin001@codequest.lk
SEED_ADMIN_PASSWORD=Admin@12345

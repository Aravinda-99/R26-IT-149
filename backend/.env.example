FLASK_PORT=5000
FLASK_DEBUG=True
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json

# Component 2: use v2 code-aware models + Model 3 (falls back to original models if files are missing)
USE_C2_V2=false

# Component 4: LLM Question Generation
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-flash-latest
USE_LLM_QUESTION_GENERATION=true
ALLOW_MOCK_QUESTIONS=false

# Component 2: pre-test explanations (POST /api/errors/explain) reuse the LLM settings above.
# Optional overrides for explanations only (leave empty to use LLM_MODEL).
# gemini-flash-latest currently resolves to a slow model (~40 s); gemini-3.5-flash answers in ~5 s.
EXPLANATION_LLM_MODEL=
EXPLANATION_LLM_THINKING_LEVEL=low
EXPLANATION_LLM_TIMEOUT_SECONDS=15
# false = never call the LLM live from /api/errors/explain (cache, else template)
EXPLANATION_USE_LLM=true

# Authentication Seed Accounts (Passwords must be hashed, never commit real passwords)
SEED_STUDENT_EMAIL=student001@codequest.lk
SEED_STUDENT_PASSWORD=Student@12345

SEED_TEACHER_EMAIL=teacher001@codequest.lk
SEED_TEACHER_PASSWORD=Teacher@12345

SEED_ADMIN_EMAIL=admin001@codequest.lk
SEED_ADMIN_PASSWORD=Admin@12345
